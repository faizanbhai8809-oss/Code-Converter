import React, { useState } from 'react';
import { BookOpen, MessageSquare, Settings, Send, Book, GraduationCap, FileText, Lightbulb, Lock, CheckCircle, CreditCard } from 'lucide-react';

const FaizanAIApp = () => {
  const [currentView, setCurrentView] = useState('home');
  const [selectedClass, setSelectedClass] = useState('');
  const [selectedSubject, setSelectedSubject] = useState('');
  const [question, setQuestion] = useState('');
  const [chatHistory, setChatHistory] = useState([]);
  const [apiKey, setApiKey] = useState('');
  const [showApiSettings, setShowApiSettings] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [notesUnlocked, setNotesUnlocked] = useState(false);
  const [showPayment, setShowPayment] = useState(false);
  const [paymentSuccess, setPaymentSuccess] = useState(false);

  const classes = Array.from({ length: 12 }, (_, i) => `Class ${i + 1}`);
  
  const subjects = {
    'Class 1-5': ['English', 'Hindi', 'Mathematics', 'EVS', 'General Knowledge'],
    'Class 6-8': ['English', 'Hindi', 'Mathematics', 'Science', 'Social Science', 'Sanskrit'],
    'Class 9-10': ['English', 'Hindi', 'Mathematics', 'Science', 'Social Science', 'Sanskrit', 'Computer Science'],
    'Class 11-12': ['English', 'Physics', 'Chemistry', 'Mathematics', 'Biology', 'Computer Science', 'Economics', 'Business Studies', 'Accountancy', 'History', 'Political Science', 'Geography']
  };

  const getSubjectsForClass = (cls) => {
    const classNum = parseInt(cls.split(' ')[1]);
    if (classNum <= 5) return subjects['Class 1-5'];
    if (classNum <= 8) return subjects['Class 6-8'];
    if (classNum <= 10) return subjects['Class 9-10'];
    return subjects['Class 11-12'];
  };

  const handleAskQuestion = async () => {
    if (!question.trim()) return;
    
    if (!apiKey) {
      alert('⚠️ Pehle API Key Settings mein dalein!');
      setShowApiSettings(true);
      return;
    }

    const userMessage = {
      role: 'user',
      content: question,
      class: selectedClass,
      subject: selectedSubject
    };

    setChatHistory([...chatHistory, userMessage]);
    setIsLoading(true);
    setQuestion('');

    try {
      const systemPrompt = `Aap ek helpful Indian education assistant hain. Student ${selectedClass} ka hai aur ${selectedSubject} subject ke baare mein pooch raha hai. Hindi aur English dono languages mein clear aur detailed jawab dein. Explanations simple aur samajhne mein aasan hon.`;

      const response = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-api-key': apiKey,
        },
        body: JSON.stringify({
          model: 'claude-sonnet-4-20250514',
          max_tokens: 1000,
          messages: [
            {
              role: 'user',
              content: `${systemPrompt}\n\nSawal: ${userMessage.content}`
            }
          ]
        })
      });

      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        throw new Error(errorData.error?.message || 'API call failed');
      }

      const data = await response.json();
      const aiResponse = {
        role: 'assistant',
        content: data.content[0].text
      };

      setChatHistory(prev => [...prev, aiResponse]);
    } catch (error) {
      let errorMessage = '❌ Kuch gadbad ho gayi. ';
      
      if (error.message.includes('invalid')) {
        errorMessage += 'API key galat hai. Settings mein sahi key dalein.';
      } else if (error.message.includes('credit')) {
        errorMessage += 'API account mein balance nahi hai.';
      } else {
        errorMessage += 'Internet connection check karein aur phir try karein.';
      }

      setChatHistory(prev => [...prev, {
        role: 'assistant',
        content: errorMessage
      }]);
    } finally {
      setIsLoading(false);
    }
  };

  const handlePayment = () => {
    const upiUrl = `upi://pay?pa=9625465763@ybl&pn=Faizan AI&am=5&cu=INR&tn=Notes Access Payment`;
    
    window.location.href = upiUrl;
    
    setTimeout(() => {
      const confirmed = window.confirm('Kya payment successful ho gayi? ✅');
      if (confirmed) {
        setPaymentSuccess(true);
        setNotesUnlocked(true);
        setShowPayment(false);
        alert('🎉 Payment Successful! Notes unlock ho gaye hain.');
      }
    }, 3000);
  };

  const renderHome = () => (
    <div className="p-6 space-y-6">
      <div className="text-center mb-8">
        <h1 className="text-5xl font-bold bg-gradient-to-r from-red-600 to-pink-600 bg-clip-text text-transparent mb-2">
          Faizan AI
        </h1>
        <p className="text-gray-700 font-medium">Class 1 se 12 tak ka Complete Education Assistant</p>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <button
          onClick={() => setCurrentView('classes')}
          className="bg-gradient-to-r from-red-500 to-pink-500 text-white p-6 rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:scale-105"
        >
          <GraduationCap className="w-12 h-12 mx-auto mb-3" />
          <h2 className="text-xl font-bold mb-2">All Classes</h2>
          <p className="text-sm opacity-90">Class 1 se 12 tak sabhi classes</p>
        </button>

        <button
          onClick={() => setCurrentView('chat')}
          className="bg-gradient-to-r from-pink-500 to-red-500 text-white p-6 rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:scale-105"
        >
          <MessageSquare className="w-12 h-12 mx-auto mb-3" />
          <h2 className="text-xl font-bold mb-2">AI Chat</h2>
          <p className="text-sm opacity-90">Koi bhi sawal poochein</p>
        </button>

        <button
          onClick={() => {
            if (!notesUnlocked) {
              setShowPayment(true);
            } else {
              setCurrentView('notes');
            }
          }}
          className="bg-gradient-to-r from-red-600 to-pink-600 text-white p-6 rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:scale-105 relative"
        >
          {!notesUnlocked && (
            <div className="absolute top-2 right-2">
              <Lock className="w-6 h-6" />
            </div>
          )}
          <FileText className="w-12 h-12 mx-auto mb-3" />
          <h2 className="text-xl font-bold mb-2">Study Notes</h2>
          <p className="text-sm opacity-90">{notesUnlocked ? 'Unlocked ✅' : 'Premium - ₹5 Only'}</p>
        </button>

        <button
          onClick={() => setShowApiSettings(true)}
          className="bg-gradient-to-r from-pink-600 to-red-600 text-white p-6 rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:scale-105"
        >
          <Settings className="w-12 h-12 mx-auto mb-3" />
          <h2 className="text-xl font-bold mb-2">API Settings</h2>
          <p className="text-sm opacity-90">API Key configure karein</p>
        </button>
      </div>

      {apiKey && (
        <div className="bg-green-100 border-l-4 border-green-500 p-4 rounded">
          <p className="text-green-800 font-medium">✅ API Key configured hai - App ready hai!</p>
        </div>
      )}
    </div>
  );

  const renderClasses = () => (
    <div className="p-6">
      <button
        onClick={() => setCurrentView('home')}
        className="mb-4 text-red-600 font-semibold hover:underline"
      >
        ← Back to Home
      </button>
      <h2 className="text-3xl font-bold mb-6 text-center bg-gradient-to-r from-red-600 to-pink-600 bg-clip-text text-transparent">
        Apni Class Select Karein
      </h2>
      <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
        {classes.map((cls) => (
          <button
            key={cls}
            onClick={() => {
              setSelectedClass(cls);
              setCurrentView('subjects');
            }}
            className="bg-gradient-to-br from-red-500 to-pink-500 text-white p-6 rounded-xl hover:from-red-600 hover:to-pink-600 transition-all shadow-lg transform hover:scale-105"
          >
            <BookOpen className="w-8 h-8 mx-auto mb-2" />
            <p className="font-bold text-lg">{cls}</p>
          </button>
        ))}
      </div>
    </div>
  );

  const renderSubjects = () => (
    <div className="p-6">
      <button
        onClick={() => setCurrentView('classes')}
        className="mb-4 text-red-600 font-semibold hover:underline"
      >
        ← Back to Classes
      </button>
      <h2 className="text-3xl font-bold mb-2 text-center bg-gradient-to-r from-red-600 to-pink-600 bg-clip-text text-transparent">
        {selectedClass}
      </h2>
      <p className="text-center text-gray-700 mb-6 font-medium">Subject Select Karein</p>
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        {getSubjectsForClass(selectedClass).map((subject) => (
          <button
            key={subject}
            onClick={() => {
              setSelectedSubject(subject);
              setCurrentView('chat');
            }}
            className="bg-gradient-to-br from-pink-500 to-red-500 text-white p-6 rounded-xl hover:from-pink-600 hover:to-red-600 transition-all shadow-lg transform hover:scale-105"
          >
            <Book className="w-8 h-8 mx-auto mb-2" />
            <p className="font-bold">{subject}</p>
          </button>
        ))}
      </div>
    </div>
  );

  const renderChat = () => (
    <div className="flex flex-col h-screen">
      <div className="bg-gradient-to-r from-red-600 to-pink-600 text-white p-4 flex justify-between items-center shadow-lg">
        <button
          onClick={() => setCurrentView('home')}
          className="hover:underline font-semibold"
        >
          ← Home
        </button>
        <div className="text-center">
          <h2 className="font-bold text-lg">Faizan AI Chat</h2>
          {selectedClass && selectedSubject && (
            <p className="text-sm opacity-90">{selectedClass} - {selectedSubject}</p>
          )}
        </div>
        <button
          onClick={() => setChatHistory([])}
          className="text-sm hover:underline font-semibold"
        >
          Clear
        </button>
      </div>

      <div className="flex-1 overflow-y-auto p-4 bg-gradient-to-br from-pink-50 to-red-50">
        {chatHistory.length === 0 ? (
          <div className="text-center mt-20">
            <Lightbulb className="w-16 h-16 mx-auto mb-4 text-yellow-500" />
            <h3 className="text-2xl font-bold mb-2 text-gray-800">Koi bhi sawal poochein!</h3>
            <p className="text-gray-600">Main aapki madad karne ke liye yahan hoon 😊</p>
          </div>
        ) : (
          <div className="space-y-4 max-w-4xl mx-auto">
            {chatHistory.map((msg, idx) => (
              <div
                key={idx}
                className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}
              >
                <div
                  className={`max-w-[80%] p-4 rounded-2xl shadow-md ${
                    msg.role === 'user'
                      ? 'bg-gradient-to-r from-red-500 to-pink-500 text-white'
                      : 'bg-white text-gray-800'
                  }`}
                >
                  <p className="whitespace-pre-wrap">{msg.content}</p>
                </div>
              </div>
            ))}
            {isLoading && (
              <div className="flex justify-start">
                <div className="bg-white p-4 rounded-2xl shadow-md">
                  <p className="text-gray-600">💭 Jawab likh raha hoon...</p>
                </div>
              </div>
            )}
          </div>
        )}
      </div>

      <div className="p-4 bg-white border-t-2 border-pink-200 shadow-lg">
        <div className="flex gap-2 max-w-4xl mx-auto">
          <input
            type="text"
            value={question}
            onChange={(e) => setQuestion(e.target.value)}
            onKeyPress={(e) => e.key === 'Enter' && !isLoading && handleAskQuestion()}
            placeholder="Apna sawal yahan likhein..."
            className="flex-1 p-4 border-2 border-pink-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
          />
          <button
            onClick={handleAskQuestion}
            disabled={isLoading || !question.trim()}
            className="bg-gradient-to-r from-red-600 to-pink-600 text-white px-6 rounded-xl hover:from-red-700 hover:to-pink-700 disabled:from-gray-400 disabled:to-gray-500 transition-all shadow-md"
          >
            <Send className="w-6 h-6" />
          </button>
        </div>
      </div>
    </div>
  );

  const renderNotes = () => (
    <div className="p-6">
      <button
        onClick={() => setCurrentView('home')}
        className="mb-4 text-red-600 font-semibold hover:underline"
      >
        ← Back to Home
      </button>
      <h2 className="text-3xl font-bold mb-6 text-center bg-gradient-to-r from-red-600 to-pink-600 bg-clip-text text-transparent">
        Premium Study Notes 📚
      </h2>
      <div className="bg-green-100 border-l-4 border-green-500 p-4 mb-6 rounded">
        <p className="text-green-800 font-medium flex items-center gap-2">
          <CheckCircle className="w-5 h-5" />
          Notes unlock ho gaye hain! Kisi bhi topic ke liye AI se detailed notes mange.
        </p>
      </div>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {[
          { title: 'Chapter Summaries', desc: 'Har chapter ka complete summary' },
          { title: 'Important Questions', desc: 'Exam mein aane wale questions' },
          { title: 'Formulas & Definitions', desc: 'Sabhi important formulas' },
          { title: 'Previous Year Papers', desc: 'Past exam papers aur solutions' }
        ].map((noteType) => (
          <div key={noteType.title} className="bg-white p-6 rounded-xl shadow-lg border-2 border-pink-200">
            <h3 className="font-bold text-lg mb-2 text-red-600">{noteType.title}</h3>
            <p className="text-gray-600 text-sm mb-4">{noteType.desc}</p>
            <button
              onClick={() => setCurrentView('chat')}
              className="bg-gradient-to-r from-red-500 to-pink-500 text-white px-4 py-2 rounded-lg hover:from-red-600 hover:to-pink-600 transition-all"
            >
              AI se notes le →
            </button>
          </div>
        ))}
      </div>
    </div>
  );

  const renderPayment = () => (
    <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
      <div className="bg-white rounded-2xl p-8 max-w-md w-full shadow-2xl">
        <div className="text-center mb-6">
          <div className="bg-gradient-to-r from-red-500 to-pink-500 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
            <Lock className="w-10 h-10 text-white" />
          </div>
          <h2 className="text-3xl font-bold mb-2 bg-gradient-to-r from-red-600 to-pink-600 bg-clip-text text-transparent">
            Premium Notes
          </h2>
          <p className="text-gray-600">Lifetime access sirf ₹5 mein!</p>
        </div>

        <div className="bg-pink-50 p-6 rounded-xl mb-6">
          <div className="flex justify-between items-center mb-4">
            <span className="text-gray-700 font-medium">Study Notes Access</span>
            <span className="text-2xl font-bold text-red-600">₹5</span>
          </div>
          <ul className="space-y-2 text-sm text-gray-600">
            <li className="flex items-center gap-2">
              <CheckCircle className="w-4 h-4 text-green-500" />
              All Subjects ke Notes
            </li>
            <li className="flex items-center gap-2">
              <CheckCircle className="w-4 h-4 text-green-500" />
              Chapter-wise Summaries
            </li>
            <li className="flex items-center gap-2">
              <CheckCircle className="w-4 h-4 text-green-500" />
              Important Questions
            </li>
            <li className="flex items-center gap-2">
              <CheckCircle className="w-4 h-4 text-green-500" />
              Lifetime Access
            </li>
          </ul>
        </div>

        <button
          onClick={handlePayment}
          className="w-full bg-gradient-to-r from-red-600 to-pink-600 text-white py-4 rounded-xl font-bold text-lg hover:from-red-700 hover:to-pink-700 transition-all shadow-lg flex items-center justify-center gap-2"
        >
          <CreditCard className="w-6 h-6" />
          Pay ₹5 via UPI
        </button>

        <button
          onClick={() => setShowPayment(false)}
          className="w-full mt-3 bg-gray-200 text-gray-700 py-3 rounded-xl font-semibold hover:bg-gray-300 transition-all"
        >
          Cancel
        </button>

        <p className="text-center text-xs text-gray-500 mt-4">
          UPI ID: 9625465763@ybl
        </p>
      </div>
    </div>
  );

  const renderApiSettings = () => (
    <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
      <div className="bg-white rounded-2xl p-8 max-w-md w-full shadow-2xl">
        <h2 className="text-3xl font-bold mb-4 bg-gradient-to-r from-red-600 to-pink-600 bg-clip-text text-transparent">
          API Settings ⚙️
        </h2>
        <p className="text-sm text-gray-600 mb-4">
          Anthropic Claude API key dalein:
        </p>
        <ol className="text-xs text-gray-600 mb-4 space-y-1 list-decimal list-inside">
          <li>https://console.anthropic.com pe jayein</li>
          <li>Account banayein (free credit milega)</li>
          <li>API key generate karein</li>
          <li>Yahan paste karein</li>
        </ol>
        <input
          type="password"
          value={apiKey}
          onChange={(e) => setApiKey(e.target.value)}
          placeholder="sk-ant-api..."
          className="w-full p-4 border-2 border-pink-300 rounded-xl mb-4 focus:outline-none focus:ring-2 focus:ring-red-500"
        />
        <div className="flex gap-2">
          <button
            onClick={() => {
              if (apiKey.trim()) {
                setShowApiSettings(false);
                alert('✅ API Key save ho gayi! Ab app use kar sakte hain.');
              } else {
                alert('⚠️ Pehle API key enter karein!');
              }
            }}
            className="flex-1 bg-gradient-to-r from-red-600 to-pink-600 text-white py-3 rounded-xl font-bold hover:from-red-700 hover:to-pink-700 transition-all"
          >
            Save ✓
          </button>
          <button
            onClick={() => setShowApiSettings(false)}
            className="flex-1 bg-gray-300 py-3 rounded-xl font-semibold hover:bg-gray-400 transition-all"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
  );

  return (
    <div className="min-h-screen bg-gradient-to-br from-red-50 via-pink-50 to-red-50">
      {currentView === 'home' && renderHome()}
      {currentView === 'classes' && renderClasses()}
      {currentView === 'subjects' && renderSubjects()}
      {currentView === 'chat' && renderChat()}
      {currentView === 'notes' && renderNotes()}
      {showPayment && renderPayment()}
      {showApiSettings && renderApiSettings()}
    </div>
  );
};

export default FaizanAIApp;
